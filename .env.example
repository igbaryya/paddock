# Every variable is optional — paddock runs with no .env at all. Copy this file to .env and
# uncomment what you want to change. Variables already set in the environment win over this file.

# Interface the server binds. Keep it on loopback unless you know what you are exposing.
# PADDOCK_HOST=127.0.0.1

# Port for the dashboard.
# PADDOCK_PORT=4599

# Override the MCP listener port stored in applications.json. When unset, MCP uses the port chosen
# in the installation wizard and kept in your data directory.
# PADDOCK_MCP_PORT=4600

# A fresh install brings MCP up on 4600 (or any free port, if 4600 is taken) without the setup
# wizard. Set false to keep MCP off until it is installed from the dashboard.
# PADDOCK_MCP_AUTO_CONFIGURE=true

# MCP sessions: how long one may sit unused before it is closed, and how many are kept open at once.
# PADDOCK_MCP_SESSION_IDLE_MS=3600000
# PADDOCK_MCP_MAX_SESSIONS=64

# The audit of agents' tool calls: calls kept in memory, and the size at which mcp-calls.jsonl rotates.
# PADDOCK_MCP_AUDIT_BUFFER_CALLS=2000
# PADDOCK_MCP_AUDIT_FILE_MAX_BYTES=5242880

# Where applications.json, runtime.json and logs/ live. Defaults to the OS application data
# directory: %APPDATA%\paddock, ~/Library/Application Support/paddock, or
# $XDG_DATA_HOME/paddock (else ~/.local/share/paddock). Use an absolute path — a relative one
# is resolved against whatever directory the server was launched from.
# PADDOCK_DATA_DIR=/path/to/paddock-data

# Log lines kept in memory per process, for the dashboard and read_logs.
# PADDOCK_LOG_BUFFER_LINES=2000

# Size at which a process log file is rotated to <processId>.1.jsonl, bytes.
# PADDOCK_LOG_FILE_MAX_BYTES=5242880

# Set to false to keep logs in memory only and write nothing to disk.
# PADDOCK_LOG_PERSIST=true

# Time a process group gets after SIGTERM before it is force-killed, milliseconds.
# PADDOCK_STOP_GRACE_MS=5000

# Time a freshly spawned process must survive before it counts as running, milliseconds.
# PADDOCK_START_SETTLE_MS=1500

# Set to false to leave processes from a previous run alone at startup instead of killing the
# ones this manager can still identify.
# PADDOCK_REAP_ORPHANS=true

# Load a .env from somewhere other than the project root. Only useful in the real environment —
# setting it inside a .env file has no effect.
# PADDOCK_ENV_FILE=/path/to/paddock.env

# How long a listening-port scan is reused before the OS is asked again, milliseconds.
# PADDOCK_PORT_SCAN_TTL_MS=3000

# How often open dashboards are pushed a fresh port list, milliseconds. 0 turns background
# scanning off entirely, leaving the ports view to update only when Refresh is pressed.
# PADDOCK_PORT_SCAN_INTERVAL_MS=5000

# Grace an unmanaged process gets between the polite signal and the forced one, milliseconds.
# PADDOCK_PORT_STOP_GRACE_MS=5000

# How long one statement from a database tool may run on a PostgreSQL application before the
# server cancels it, milliseconds.
# PADDOCK_PG_STATEMENT_TIMEOUT_MS=15000

# How long a database tool waits to connect to a PostgreSQL application's server, milliseconds.
# PADDOCK_PG_CONNECT_TIMEOUT_MS=5000
